<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VerbesFrancais" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Le Monde Primary Brand Colors -->
        <item name="colorPrimary">@color/lemonde_black</item>
        <item name="colorPrimaryVariant">@color/lemonde_dark_gray</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Le Monde Accent Yellow -->
        <item name="colorSecondary">@color/lemonde_yellow</item>
        <item name="colorSecondaryVariant">@color/lemonde_yellow_dark</item>
        <item name="colorOnSecondary">@color/lemonde_black</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/lemonde_light_bg</item>
        <item name="colorSurface">@color/lemonde_card_bg</item>
        <item name="colorOnSurface">@color/lemonde_text_primary</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/LeMonde.Button</item>
    </style>

    <style name="LeMonde.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/lemonde_black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="LeMonde.Button.Accent" parent="LeMonde.Button">
        <item name="backgroundTint">@color/lemonde_yellow</item>
        <item name="android:textColor">@color/lemonde_black</item>
    </style>

    <style name="LeMonde.Button.Secondary" parent="LeMonde.Button">
        <item name="backgroundTint">@color/lemonde_card_bg</item>
        <item name="android:textColor">@color/lemonde_text_primary</item>
        <item name="strokeColor">@color/lemonde_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
